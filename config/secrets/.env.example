# 复制为 config/secrets/.env 后修改；勿提交真实密钥。
# 栈侧（Redis/ES/Ollama/Mem0）变量请在 deploy/stack 配置；主程序若需可在此文件自行追加。

LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0
LLM_PROXY_DB_DRIVER=postgresql
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change_me
PG_DATABASE=centag
PG_SSL_MODE=disable

LLM_PROXY_ADMIN_USERNAME=admin
LLM_PROXY_ADMIN_PASSWORD=change_me
LLM_PROXY_ADMIN_API_KEY=
# 可选：覆盖 API Key 加密存储密钥；留空则启动时自动生成并写入 system_config（默认可二次查看）
# LLM_PROXY_API_KEY_STORAGE_SECRET=
# 设为 true 时关闭二次查看：完整密钥仅在创建响应中返回一次
# LLM_PROXY_API_KEY_REVEAL_ONCE=false

# Minimal 版可选：配置后 /v1 需 Bearer 鉴权（也可在 WebUI「设置」创建 llmproxy_* 密钥）
# CENTAG_PROXY_API_KEY=
