# Centag 统一配置示例 — 复制到 ~/.centag/centag.conf 后修改
#   mkdir -p ~/.centag && cp config/centag.conf.example ~/.centag/centag.conf && chmod 600 ~/.centag/centag.conf
#
# 优先级：环境变量 > ~/.centag/centag.conf > 代码内置默认值
# 旧路径（config/secrets/.env、.env.middleware、deploy/stack/.env）已废弃，不再加载。
# 语法：KEY=VALUE，支持 # 注释与 export 前缀；值不需要引号。

# ── 服务 ────────────────────────────────────────────────
LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0

# ── 数据库 ──────────────────────────────────────────────
# personal/minimal 版固定使用 SQLite；team 版可选 PostgreSQL
LLM_PROXY_DB_DRIVER=sqlite
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=change_me
# PG_DATABASE=centag
# PG_SSL_MODE=disable

# ── 管理员首轮 seed（可选）──────────────────────────────
LLM_PROXY_ADMIN_USERNAME=admin
# LLM_PROXY_ADMIN_PASSWORD=
# LLM_PROXY_ADMIN_API_KEY=
# 可选：API Key 加密存储密钥；留空则启动时自动生成并写入 system_config
# LLM_PROXY_API_KEY_STORAGE_SECRET=

# ── 商业许可证（team 版）────────────────────────────────
# CENTAG_LICENSE_KEY=
# CENTAG_LICENSE_PUBKEYS=

# ── 配置同步（飞书只读 Client App；部署包由 runtime.env 注入，一般无需在此配置）──
# 开发环境如需读写 key 或覆盖表 ID，在此设置：
# CENTAG_CONFIGSYNC_FEISHU_CLIENT_APP_ID=
# CENTAG_CONFIGSYNC_FEISHU_CLIENT_APP_SECRET=
# CENTAG_CONFIGSYNC_FEISHU_APP_TOKEN=
# CENTAG_CONFIGSYNC_FEISHU_PRICING_TABLE_ID=
# CENTAG_CONFIGSYNC_FEISHU_PIPELINE_TABLE_ID=
# CENTAG_CONFIGSYNC_FEISHU_CONFIG_TABLE_ID=
# CENTAG_CONFIGSYNC_FEISHU_BACKEND_TABLE_ID=
# CENTAG_CONFIGSYNC_FEISHU_SKILL_TABLE_ID=

# ── 公共初始化配置源（无凭据快照；空格分隔多镜像）────────
# CENTAG_CONFIGSYNC_SNAPSHOT_URL=https://gitee.example/centag-config/team/latest.json

# ── 数据源覆盖（远程 URL，优先级低于飞书，高于本地文件）──
# CENTAG_PRICING_URL=
# CENTAG_PIPELINE_TEMPLATES_URL=
# CENTAG_SYSTEM_CONFIG_URL=

# ── Minimal 版可选 ──────────────────────────────────────
# CENTAG_PROXY_API_KEY=
