# Profile: cached — 缓存加速模式环境变量
# 复制为 config/profiles/cached/.env 后填入 API Key
# 特点：PostgreSQL + pgvector 由 stack 提供；应用层 modular 部署

# --- 服务端口 ---
LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0

# --- 数据库（PostgreSQL + pgvector，stack 中间件） ---
LLM_PROXY_DB_DRIVER=postgresql
PG_HOST=proxyclaw-postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=${PG_PASSWORD:-postgres}
PG_DATABASE=proxyclaw
PG_SSL_MODE=disable

# --- 管理员账号（首次启动时创建） ---
LLM_PROXY_ADMIN_USERNAME=admin
LLM_PROXY_ADMIN_PASSWORD=change_me

# --- 代理默认（全发行版统一透明模式；体验缓存可改为 cache-mode）---
LLM_PROXY_DEFAULT_MODE=transparent-proxy

# --- LLM 供应商 API Key（至少填一个） ---
OPENAI_API_KEY=

# --- Embedding 配置 ---
# 方式 A：本地 Ollama embedding（推荐）
#   EMBEDDING_BACKEND=ollama-local
#   EMBEDDING_MODEL=bge-m3
# 方式 B：OpenAI embedding
#   EMBEDDING_BACKEND=openai
#   EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BACKEND=ollama-local
EMBEDDING_MODEL=bge-m3

# --- Ollama 本地模型（用于 embedding，可选） ---
# true  → profile up 会 stack ensure postgresql + ollama
OLLAMA_ENABLED=true
OLLAMA_HOST=http://proxyclaw-ollama:11434
OLLAMA_BASE_URL=http://proxyclaw-ollama:11434

# --- 日志 ---
LOG_LEVEL=info