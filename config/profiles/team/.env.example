# Profile: team — 服务集群版环境变量
# 复制为 config/profiles/team/.env 后按需修改
# 特点：PostgreSQL + Redis + Qdrant + CENTAG_EDITION=team

# --- 服务端口 ---
LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0

# --- 产品版本（团队版启用完整管理功能） ---
CENTAG_EDITION=team

# --- 代理默认（全发行版统一：透明模式）---
LLM_PROXY_DEFAULT_MODE=transparent-proxy

# --- 数据库（PostgreSQL） ---
LLM_PROXY_DB_DRIVER=postgresql
POSTGRES_ENABLED=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=centag
POSTGRES_PORT=5432

# PostgreSQL 连接配置
PG_HOST=centag-postgresql
PG_PORT=5432
PG_USER=${POSTGRES_USER:-postgres}
PG_PASSWORD=${POSTGRES_PASSWORD:-postgres}
PG_DATABASE=${POSTGRES_DB:-centag}
PG_SSL_MODE=disable

# --- Redis 缓存 ---
REDIS_ENABLED=true
REDIS_HOST=centag-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 向量数据库（Qdrant） ---
VECTOR_ENABLED=true
VECTOR_TYPE=qdrant
QDRANT_HOST=centag-qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- 管理员账号（首次启动时创建） ---
LLM_PROXY_ADMIN_USERNAME=admin
LLM_PROXY_ADMIN_PASSWORD=change_me
ADMIN_API_KEY=pc-admin-key-change-me

# --- 外部供应商 API Key（至少填一个） ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- Ollama 本地模型（可选，默认关闭） ---
OLLAMA_ENABLED=false
OLLAMA_HOST=http://centag-ollama:11434
OLLAMA_BASE_URL=http://centag-ollama:11434

# --- 日志 ---
LOG_LEVEL=info
LLM_PROXY_LOG_PATH=/app/logs
LLM_PROXY_LOG_OUTPUT=both
LLM_PROXY_LOG_FORMAT=console
