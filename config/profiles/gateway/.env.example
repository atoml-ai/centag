# Profile: gateway — 统一接入网关环境变量
# 复制为 config/profiles/gateway/.env 后按需修改
# 特点：SQLite 应用层，无 PostgreSQL；默认仅应用容器 + 线上 API Key
# 注意：本文件进入容器；deploy/stack/.env 仅由 start.sh 在宿主机侧加载（stack ensure），不注入 gateway 容器
#
# 发行包名 gateway ↔ 运行时 CENTAG_EDITION=personal（个人全功能，非 team）

# --- 产品版本（必填语义；勿改成 team） ---
CENTAG_EDITION=personal

# --- 服务端口 ---
LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0

# --- 数据库（SQLite，内置无需容器） ---
LLM_PROXY_DB_DRIVER=sqlite
LLM_PROXY_DB_PATH=./storage/centag.db
# entrypoint 用 SQLITE_PATH；与 LLM_PROXY_DB_PATH 保持一致
SQLITE_PATH=/app/storage/centag.db
POSTGRES_ENABLED=false

# --- 管理员账号（首次启动时创建） ---
LLM_PROXY_ADMIN_USERNAME=admin
LLM_PROXY_ADMIN_PASSWORD=change_me

# --- Ollama 本地模型（可选，默认关闭） ---
# false → 默认：仅启动 Centag，使用下方外部供应商 API Key（推荐）
# true  → profile up 会 stack ensure ollama，应用通过 deploy/stack-network 访问
OLLAMA_ENABLED=false
OLLAMA_HOST=http://centag-ollama:11434
OLLAMA_BASE_URL=http://centag-ollama:11434

# --- 外部供应商 API Key（如不使用 Ollama，至少填一个） ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- 代理默认（各发行版统一：透明模式）---
LLM_PROXY_DEFAULT_MODE=transparent-proxy

# --- 日志（容器内建议 both + /app/logs，docker logs 与卷内文件同步） ---
LOG_LEVEL=info
LLM_PROXY_LOG_PATH=/app/logs
LLM_PROXY_LOG_OUTPUT=both
LLM_PROXY_LOG_FORMAT=console