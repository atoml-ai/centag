# Profile: agent-memory — 智能体记忆模式环境变量
# 复制为 config/profiles/agent-memory/.env 后按需修改
# 特点：modular 部署 — 中间件由 ./start.sh stack ensure 提供

# --- 服务端口 ---
LLM_PROXY_SERVER_PORT=20060
LLM_PROXY_SERVER_HOST=0.0.0.0

# --- 数据库（PostgreSQL + pgvector，stack 中间件） ---
PG_HOST=proxyclaw-postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=${PG_PASSWORD:-postgres}
PG_DATABASE=proxyclaw
PG_SSL_MODE=disable

# --- 管理员账号（首次启动时创建） ---
# 若项目根目录 config/secrets/.env 中已配置，以下值会被覆盖
LLM_PROXY_ADMIN_USERNAME=admin
LLM_PROXY_ADMIN_PASSWORD=change_me

# --- 代理默认（全发行版统一透明模式；体验记忆可改为 mem0-memory）---
LLM_PROXY_DEFAULT_MODE=transparent-proxy

# --- API Key（优先从 config/secrets/.env 读取） ---
# LLM_PROXY_ADMIN_API_KEY=

# --- Ollama（默认启用，提供本地 LLM + Embedding） ---
OLLAMA_ENABLED=true
OLLAMA_HOST=http://proxyclaw-ollama:11434
OLLAMA_BASE_URL=http://proxyclaw-ollama:11434

# --- Mem0 配置（stack ensure mem0 时注入容器） ---
MEM0_PORT=20061
MEM0_JWT_SECRET=change-me-mem0-jwt-secret
MEM0_ADMIN_API_KEY=change-me-mem0-admin-key
MEM0_AUTH_DISABLED=false
MEM0_POSTGRES_HOST=proxyclaw-postgresql
MEM0_POSTGRES_PORT=5432
# 必须与 ProxyClaw 数据库隔离，防止表冲突
MEM0_APP_DB_NAME=mem0_app
MEM0_POSTGRES_COLLECTION_NAME=memories
MEM0_QDRANT_HOST=proxyclaw-qdrant
MEM0_QDRANT_PORT=6333
MEM0_TELEMETRY=false

# Mem0 LLM / Embedder Provider：ollama 或 openai
LLM_PROVIDER=ollama
EMBEDDER_PROVIDER=ollama
MEM0_EMBEDDING_DIMS=1024
MEM0_DEFAULT_LLM_MODEL=llama3.1
MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3

# --- 外部供应商 API Key（如不使用 Ollama，填以下 Key） ---
OPENAI_API_KEY=
MEM0_OPENAI_API_KEY=
MEM0_OPENAI_BASE_URL=https://api.openai.com/v1
MEM0_OPENAI_MODEL=gpt-4o-mini
MEM0_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pi Sandbox 配置 ---
PI_CONTAINER_NAME=pi-sandbox
PI_SESSION_DIR=/data/sessions
PI_WORK_DIR=/workspace
HOST_WORKSPACE_DIR=./workspace
PI_MAX_MEMORY=512m
PI_MAX_CPU=1.0
GO_CLIENT_PORT=8080

# --- 日志 ---
LOG_LEVEL=info