# Centag — 第三方系统 / 渠道打包默认参数
# 被 scripts/packaging/package.sh、deploy/fnos/build-fpk.sh、Makefile 读取。
# 环境变量与 CLI 参数可覆盖本文件中的同名项。

# 应用标识（产物命名、manifest 对齐）
PACKAGE_APP_NAME=Centag
PACKAGE_APP_ID=centag

# 目标架构：amd64 | arm64（也可写 x86_64 / aarch64）
PACKAGE_ARCH=amd64

# 默认打包模式（fnOS 等目标适用）：native | docker
PACKAGE_MODE=native

# 发行版：minimal（默认）| personal | team
# 运行时 CENTAG_EDITION=personal
PACKAGE_EDITION=minimal

# 产物输出目录（相对仓库根或绝对路径）
# dist/ 仅放发行版源码（minimal/personal/team）；构建物统一到 bin/（已被 .gitignore）
PACKAGE_OUTPUT=bin/packages

# Docker 模式镜像前缀（末尾可带 /；空字符串表示不加前缀）
IMAGE_PREFIX=ghcr.io/marmotcai/

# 管理员凭据（可选；留空则打包时从 config/secrets/.env 读取）
# 优先级：--admin-password > PACKAGE_ADMIN_PASSWORD > config/secrets/.env
# PACKAGE_ADMIN_PASSWORD=
# PACKAGE_ADMIN_USERNAME=admin
# PACKAGE_ADMIN_API_KEY=
# Web「复制完整 API Key」必需；留空则读 .env 的 LLM_PROXY_API_KEY_STORAGE_SECRET，再空则打包时自动生成
# PACKAGE_API_KEY_STORAGE_SECRET=
