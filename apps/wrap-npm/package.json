{
  "name": "centag-wrap",
  "version": "0.2.7",
  "description": "Centag system PAC / process-proxy helper (npm wrapper around the Go binary). Wraps third-party agents (OpenCode etc.) to route LLM traffic through Centag MITM.",
  "type": "module",
  "bin": {
    "centag-wrap": "./bin/run.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "centag",
    "proxy",
    "mitm",
    "llm",
    "agent",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atoml-ai/centag.git"
  },
  "homepage": "https://github.com/atoml-ai/centag/tree/main/apps/wrap",
  "bugs": {
    "url": "https://github.com/atoml-ai/centag/issues"
  }
}
