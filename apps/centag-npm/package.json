    "openai",
    "anthropic",
    "gemini",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atoml-ai/centag.git"
  },
  "homepage": "https://github.com/atoml-ai/centag",
  "bugs": {
    "url": "https://github.com/atoml-ai/centag/issues"
  },
  "publishConfig": {
    "access": "public"
  }
