{
  "name": "@atomlai/centag",
  "version": "0.3.4",
  "description": "Centag — LLM unified gateway. Installs the Go binary via postinstall from GitHub Releases.",
  "type": "module",
  "bin": {
    "centag": "bin/run.js"
  },
  "files": [
    "bin/",
    "lib/",
    "static/",
    "install.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test"
