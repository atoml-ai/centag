# Centag - 纯前端 Docker 镜像
# 2 阶段构建：frontend-builder → nginx runtime

ARG FRONTEND_BASE_IMAGE=centag-frontend-base:latest
FROM ${FRONTEND_BASE_IMAGE} AS frontend-builder

# WORKDIR=/apps（基础镜像）；@shared → ./shared；outDir → /bin/server/static
COPY web/ ./
RUN npm run build

FROM nginx:alpine

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo Asia/Shanghai > /etc/timezone

COPY --from=frontend-builder /bin/server/static /usr/share/nginx/html/static
COPY deploy/docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/static/ || curl -f http://localhost/static/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
