#!/bin/bash

### This script is called after saving the configuration page.
### 兼容两种调用方式：
###   1) 旧版：$1 为 JSON 格式配置参数（centag.conf 内容），直接持久化
###   2) 新版：配置向导（wizard/config）值通过 wizard_* 环境变量传入，据此生成 centag.conf

resolve_data_dir() {
  local dd="${TRIM_DATA_SHARE_PATHS%%:*}"
  [ -n "$dd" ] && [ -d "$dd" ] && { printf '%s' "$dd"; return; }
  local candidate
  for candidate in \
    "/vol1/@appshare/centag" \
    "/vol1/@appshare/centag/data" \
    "${TRIM_APPDEST:-/vol1/@appcenter/centag}/data" \
    "/vol1/@appdata/centag/data"
  do
    [ -d "$candidate" ] && { printf '%s' "$candidate"; return; }
  done
  printf '%s' "${TRIM_DATA_SHARE_PATHS%%:*}"
}

DATA_DIR="$(resolve_data_dir)"
CONF_FILE="${DATA_DIR}/centag.conf"

mkdir -p "${DATA_DIR}"

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

write_conf() {
  local clean="$1"
  local db_driver="$2"
  if [ "${db_driver}" = "postgresql" ]; then
    {
      printf '{"clean_data_on_uninstall":%s,' "${clean}"
      printf '"db_driver":"postgresql",'
      printf '"pg_host":"%s",'   "$(json_escape "${wizard_pg_host:-localhost}")"
      printf '"pg_port":"%s",'   "$(json_escape "${wizard_pg_port:-5432}")"
      printf '"pg_user":"%s",'   "$(json_escape "${wizard_pg_user:-postgres}")"
      printf '"pg_password":"%s",' "$(json_escape "${wizard_pg_password:-}")"
      printf '"pg_db":"%s"}'     "$(json_escape "${wizard_pg_db:-centag}")"
    } > "${CONF_FILE}"
  else
    printf '{"clean_data_on_uninstall":%s,"db_driver":"sqlite"}' "${clean}" > "${CONF_FILE}"
  fi
}

if [ -n "$1" ]; then
  echo "$1" > "${CONF_FILE}"
  echo "配置已保存: ${CONF_FILE}"
  exit 0
fi

clean="false"
case "${wizard_clean_data_on_uninstall:-}" in
  true|1|on|yes) clean="true" ;;
esac

db_driver="${wizard_db_driver:-sqlite}"
write_conf "${clean}" "${db_driver}"
echo "配置已保存(向导): ${CONF_FILE} (db=${db_driver}, clean=${clean})"

# ── PostgreSQL 就绪保障（切到 PostgreSQL 时建库/放行/验证，root 免密 peer 管理）─
# fnOS 系统 PG：pg_hba admin 库 TCP 被拒、postgres 角色无密码、包用户无权管库。
# run-as root 后经 socket peer 可直接建库/追加 pg_hba 规则；
# 失败仅告警（应用降级数据卷 SQLite，数据仍受保留保护），不阻断配置保存。
pg_ready() {
  [ "${db_driver}" = "postgresql" ] || return 0
  command -v psql >/dev/null 2>&1 || { echo "[WARN] 未找到 psql，跳过 PostgreSQL 就绪检查"; return 0; }

  local p u w d sock s
  p="${wizard_pg_port:-5432}"
  u="${wizard_pg_user:-postgres}"; w="${wizard_pg_password:-}"; d="${wizard_pg_db:-centag}"

  local PSQL_ADMIN=""
  if [ "$(id -u)" = "0" ]; then
    for s in /var/run/postgresql /run/postgresql /tmp; do
      [ -S "${s}/.s.PGSQL.${p}" ] || continue
      PSQL_ADMIN="psql -h ${s} -p ${p} -U ${u}"
      break
    done
  fi

  # 数据库存在性检查（root peer 优先，TCP+密码兜底）
  local exists=""
  if [ -n "${PSQL_ADMIN}" ] && [ "$(${PSQL_ADMIN} -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname='${d}'" 2>/dev/null)" = "1" ]; then
    exists="1"
  else
    exists="$(PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname='${d}'" 2>/dev/null)"
  fi

  if [ "${exists}" != "1" ]; then
    echo "PostgreSQL 数据库 ${d} 不存在，尝试创建…"
    local created=""
    if [ -n "${PSQL_ADMIN}" ]; then
      ${PSQL_ADMIN} -d postgres -c "CREATE DATABASE \"${d}\"" >/dev/null 2>&1 && created="1"
    fi
    if [ -z "${created}" ]; then
      PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d postgres \
        -c "CREATE DATABASE \"${d}\"" >/dev/null 2>&1 && created="1"
    fi
    if [ -n "${created}" ]; then
      echo "已创建 PostgreSQL 数据库: ${d}"
    else
      echo "[WARN] 无法创建 PostgreSQL 数据库 ${d}（admin 连接被 pg_hba 拒绝、权限不足或服务不可达）"
      echo "       应用启动将降级使用数据卷 SQLite，数据仍受卸载保留保护"
      return 0
    fi
  fi

  # pg_hba 规则（root + 本机 PG）
  if [ "$(id -u)" = "0" ] && { [ "${wizard_pg_host:-localhost}" = "localhost" ] || [ "${wizard_pg_host:-}" = "127.0.0.1" ]; }; then
    local hba
    for hba in /etc/postgresql/*/main/pg_hba.conf; do
      [ -f "${hba}" ] || continue
      if ! grep -qE "^host[[:space:]]+${d}\b" "${hba}"; then
        {
          echo "# --- managed by centag (auto-added) ---"
          echo "host ${d} ${u} 127.0.0.1/32 scram-sha-256"
          echo "host ${d} ${u} ::1/128         scram-sha-256"
          echo "host ${d} ${u} 0.0.0.0/0       scram-sha-256"
        } >> "${hba}"
        echo "已向 ${hba} 追加 ${d} 的 TCP 放行规则"
      fi
    done
    systemctl reload postgresql >/dev/null 2>&1 ||
      pg_ctlcluster "$(ls /etc/postgresql 2>/dev/null | head -1)" main reload >/dev/null 2>&1 || true
  fi

  # 连接验证（应用同款 TCP+密码）；失败则降级 SQLite（不再自动改密码）
  if PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d "${d}" -Atqc "SELECT 1" >/dev/null 2>&1; then
    echo "PostgreSQL 连接验证通过: 127.0.0.1:${p}/${d}"
    return 0
  fi
  echo ""
  echo "========================================================================"
  echo "  [WARN] PostgreSQL 密码认证失败: 127.0.0.1:${p}/${d}"
  echo "         用户名 '${u}' 的密码不正确"
  echo "         应用将降级使用数据卷 SQLite（${DATA_DIR}/centag.db）"
  echo "         如需使用 PostgreSQL，请修正密码后重新保存配置"
  echo "========================================================================"
  echo ""
  return 0
}