#!/bin/bash
# =============================================================
# Centag fnOS Native 应用 - 启动/停止/状态 管理脚本
# =============================================================

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

BINARY="${TRIM_APPDEST}/bin/centag"
STATIC_DIR="${TRIM_APPDEST}/webui"
INITDATA_DIR="${TRIM_APPDEST}/config/initdata"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
LOGS_DIR="${TRIM_PKGVAR}/logs"
PORT=20060

log_msg() {
    echo "$(date +%Y-%m-%d %H:%M:%S) - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        log_msg "应用已在运行中，跳过启动"
        return 0
    fi

    log_msg "正在启动 Centag..."

    mkdir -p "${DATA_DIR}"
    mkdir -p "${LOGS_DIR}"

    export LLM_PROXY_DB_DRIVER=sqlite
    export SQLITE_PATH="${DATA_DIR}/centag.db"
    export SERVER_HOST=0.0.0.0
    export SERVER_PORT=${PORT}
    export LOG_LEVEL=info
    export LLM_PROXY_LOG_OUTPUT=both
    export LLM_PROXY_ADMIN_PASSWORD=admin123
    export TZ=Asia/Shanghai
    export LANG=C.UTF-8

    # 静态文件路径
    export STATIC_PATH="${STATIC_DIR}"
    # 初始数据路径（后端配置、流水线模板、规则文件等）
    export PROJECT_ROOT="${TRIM_APPDEST}"
    export INITDATA_PATH="${INITDATA_DIR}"

    nohup "${BINARY}" >> "${LOGS_DIR}/centag.log" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"

    local count=0
    while [ $count -lt 5 ]; do
        if kill -0 "${pid}" 2>/dev/null; then
            sleep 1
            if grep -q "listening\|started\|ready" "${LOGS_DIR}/centag.log" 2>/dev/null; then
                break
            fi
        fi
        count=$((count + 1))
    done

    log_msg "Centag 已启动，PID=${pid}"
    return 0
}

stop_process() {
    log_msg "正在停止 Centag..."

    if [ ! -r "${PID_FILE}" ]; then
        log_msg "PID 文件不存在，应用可能未运行"
        return 0
    fi

    pid=$(head -n 1 "${PID_FILE}" | tr -d [:space:])
    log_msg "PID=${pid}"

    if ! check_process "${pid}"; then
        log_msg "进程 ${pid} 不存在，清理 PID 文件"
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "发送 TERM 信号到 PID:${pid}..."
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "等待进程终止... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "发送 KILL 信号到 PID:${pid}..."
        kill -KILL "${pid}"
        sleep 1
    else
        log_msg "进程已正常终止"
    fi

    rm -f "${PID_FILE}"
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d [:space:])
        if check_process "${pid}"; then
            return 0
        else
            log_msg "进程已退出，清理残留 PID 文件"
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "用法: $0 {start|stop|status}"
    exit 1
    ;;
esac
