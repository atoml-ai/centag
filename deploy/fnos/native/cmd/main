#!/bin/bash
# =============================================================
# Centag fnOS Native 应用 - 启动/停止/状态（daemon 监督）
# =============================================================

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

APP_ROOT="${TRIM_APPDEST}"
BINARY="${APP_ROOT}/bin/centag"
DAEMON_SH="${APP_ROOT}/daemon.sh"
STATIC_DIR="${APP_ROOT}/static"
# 兼容旧包 webui 布局
if [ ! -d "${STATIC_DIR}" ] && [ -d "${APP_ROOT}/webui" ]; then
    STATIC_DIR="${APP_ROOT}/webui"
fi
INITDATA_DIR="${APP_ROOT}/config/initdata"
RUNTIME_ENV="${APP_ROOT}/config/runtime.env"

resolve_data_dir() {
  local dd="${TRIM_DATA_SHARE_PATHS%%:*}"
  [ -n "$dd" ] && [ -d "$dd" ] && { printf '%s' "$dd"; return; }
  local candidate
  for candidate in \
    "/vol1/@appshare/centag" \
    "/vol1/@appshare/centag/data" \
    "${TRIM_APPDEST:-/vol1/@appcenter/centag}/data" \
    "/vol1/@appdata/centag/data"
  do
    [ -d "$candidate" ] && { printf '%s' "$candidate"; return; }
  done
  printf '%s' "${TRIM_DATA_SHARE_PATHS%%:*}"
}

DATA_DIR="$(resolve_data_dir)"
LOGS_DIR="${TRIM_PKGVAR}/logs"
PORT=20060

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

load_runtime_env() {
    if [ -f "${RUNTIME_ENV}" ]; then
        set -a
        # shellcheck disable=SC1090
        . "${RUNTIME_ENV}"
        set +a
        log_msg "已加载运行时配置: ${RUNTIME_ENV}"
    else
        log_msg "未找到 runtime.env，使用内置默认值"
    fi
}

# 首次启动时将包内 runtime.env 合并到统一配置 ~/.centag/centag.conf
# （应用内 appenv 加载器读取该文件；env 变量优先级始终高于配置文件）
merge_runtime_env_to_conf() {
    local conf_dir="${CENTAG_HOME:-${DATA_DIR}/.centag}"
    local conf_file="${conf_dir}/centag.conf"
    export CENTAG_HOME="${conf_dir}"
    mkdir -p "${conf_dir}"
    if [ ! -f "${conf_file}" ] && [ -f "${RUNTIME_ENV}" ]; then
        {
            echo "# 由包内 runtime.env 首次合并生成（$(date '+%Y-%m-%d %H:%M:%S')）"
            cat "${RUNTIME_ENV}"
        } > "${conf_file}"
        chmod 600 "${conf_file}" 2>/dev/null || true
        log_msg "已合并 runtime.env 到统一配置: ${conf_file}"
    fi
    if [ "$(id -u)" = "0" ] && [ -n "${TRIM_RUN_USERNAME:-}" ] && [ "${TRIM_RUN_USERNAME}" != "root" ]; then
        chown -R "${TRIM_RUN_USERNAME:-centag}":"${TRIM_RUN_GROUPNAME:-${TRIM_RUN_USERNAME}}" "${conf_dir}" 2>/dev/null || true
    fi
}

# 读取配置页持久化的 centag.conf，覆盖数据库等运行配置
# 优先级: centag.conf > runtime.env > 内置默认
load_app_config() {
    local conf="${DATA_DIR}/centag.conf"
    [ -f "${conf}" ] || return 0

    local val
    json_get() {
        grep -oE "\"${1}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "${conf}" 2>/dev/null | head -1 \
            | sed -E 's/^"[^"]*"[[:space:]]*:[[:space:]]*"([^"]*)"/\1/' \
            | tr -d ' \t\r'
    }

    val="$(json_get db_driver)"
    if [ -n "${val}" ]; then
        export LLM_PROXY_DB_DRIVER="${val}"
    fi
    val="$(json_get pg_host)";  [ -n "${val}" ] && export POSTGRES_HOST="${val}"
    val="$(json_get pg_port)";  [ -n "${val}" ] && export POSTGRES_PORT="${val}"
    val="$(json_get pg_user)";  [ -n "${val}" ] && export POSTGRES_USER="${val}"
    val="$(json_get pg_password)"; [ -n "${val}" ] && export POSTGRES_PASSWORD="${val}"
    val="$(json_get pg_db)";    [ -n "${val}" ] && export POSTGRES_DB="${val}"

    log_msg "已加载应用配置: ${conf} (db=${LLM_PROXY_DB_DRIVER:-sqlite})"
}

prepare_env() {
    mkdir -p "${DATA_DIR}"
    mkdir -p "${LOGS_DIR}"
    mkdir -p "${APP_ROOT}/storage"

    # run-as root（特权包模式）时：目录必须归包用户所有，否则降权后应用读写失败
    if [ "$(id -u)" = "0" ] && [ -n "${TRIM_RUN_USERNAME:-}" ] && [ "${TRIM_RUN_USERNAME}" != "root" ]; then
        chown -R "${TRIM_RUN_USERNAME:-centag}":"${TRIM_RUN_GROUPNAME:-${TRIM_RUN_USERNAME}}" \
            "${DATA_DIR}" "${LOGS_DIR}" "${APP_ROOT}/storage" 2>/dev/null || true
    fi

    load_runtime_env
    merge_runtime_env_to_conf
    load_app_config

    # SQLite 路径必须始终指向数据卷（与 bootstrap.go 48aefc8 对齐）：
    # 即使 conf 选择 PostgreSQL，database.Init 在 PG 不可用时也会降级 sqlite，
    # 若不预设 SQLITE_PATH，降级库会落在程序目录 bin/storage/（卸载即删），
    # 导致「卸载保留数据」重装后全部丢失。此处强制落入持久化 DATA_DIR。
    export SQLITE_PATH="${SQLITE_PATH:-${DATA_DIR}/centag.db}"
    if [ "${LLM_PROXY_DB_DRIVER}" = "postgresql" ]; then
        export POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
        export POSTGRES_PORT="${POSTGRES_PORT:-5432}"
        export POSTGRES_USER="${POSTGRES_USER:-postgres}"
        export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-}"
        export POSTGRES_DB="${POSTGRES_DB:-centag}"
        export LLM_PROXY_DB_PATH="${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
        log_msg "数据库: PostgreSQL ${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}（不可用时自动降级 SQLite: ${SQLITE_PATH}）"
    else
        export LLM_PROXY_DB_PATH="${LLM_PROXY_DB_PATH:-${SQLITE_PATH}}"
        log_msg "数据库: SQLite ${SQLITE_PATH}"
    fi
    export SERVER_HOST="${SERVER_HOST:-0.0.0.0}"
    export SERVER_PORT="${SERVER_PORT:-${PORT}}"
    export LLM_PROXY_SERVER_HOST="${LLM_PROXY_SERVER_HOST:-${SERVER_HOST}}"
    export LLM_PROXY_SERVER_PORT="${LLM_PROXY_SERVER_PORT:-${SERVER_PORT}}"
    export LOG_LEVEL="${LOG_LEVEL:-info}"
    export LLM_PROXY_LOG_OUTPUT="${LLM_PROXY_LOG_OUTPUT:-both}"
    export LLM_PROXY_LOG_PATH="${LLM_PROXY_LOG_PATH:-${LOGS_DIR}}"
    export TZ="${TZ:-Asia/Shanghai}"
    export LANG="${LANG:-C.UTF-8}"

    export STATIC_PATH="${STATIC_DIR}"
    export PROJECT_ROOT="${APP_ROOT}"
    export INITDATA_PATH="${INITDATA_PATH:-${INITDATA_DIR}}"
    export CENTAG_DATA_DIR="${CENTAG_DATA_DIR:-${DATA_DIR}}"
}

# run_service_cmd：以包用户身份执行服务命令。
# privilege run-as=root 时 fnOS 以 root 运行 cmd/main，但应用不能以 root 长驻——
# 启动后用 su/setpriv 降权到包用户（TRIM_RUN_USERNAME，缺省 centag）。
drop_to_service_user() {
    if [ "$(id -u)" = "0" ] && [ -n "${TRIM_RUN_USERNAME:-}" ] && [ "${TRIM_RUN_USERNAME}" != "root" ]; then
        return 0
    fi
    return 1
}

# launch_as_service_user "<cmd words...>"：降权后台启动，输出子进程 PID
launch_as_service_user() {
    local su_cmd exec_cmd
    exec_cmd="$*"
    if drop_to_service_user; then
        local uid="${TRIM_RUN_UID:-$(id -u "${TRIM_RUN_USERNAME}" 2>/dev/null)}"
        local gid="${TRIM_RUN_GID:-$(id -g "${TRIM_RUN_USERNAME}" 2>/dev/null)}"
        if [ -n "${uid}" ] && [ -n "${gid}" ]; then
            exec_cmd=""
            local w
            for w in "$@"; do
                exec_cmd="${exec_cmd:+${exec_cmd} }$(printf '%q' "$w")"
            done
            if setpriv --reuid="${uid}" --regid="${gid}" --init-groups \
                bash -c "nohup ${exec_cmd} >> ${LOGS_DIR}/daemon.log 2>&1 & echo \$!" 2>/dev/null; then
                return 0
            fi
            su -s /bin/bash "${TRIM_RUN_USERNAME}" \
                -c "nohup ${exec_cmd} >> ${LOGS_DIR}/daemon.log 2>&1 & echo \$!"
            return 0
        fi
    fi
    nohup ${exec_cmd} >> "${LOGS_DIR}/daemon.log" 2>&1 &
    echo $!
}

start_process() {
    if status; then
        log_msg "应用已在运行中，跳过启动"
        return 0
    fi

    log_msg "正在启动 Centag（daemon）..."
    prepare_env

    if [ ! -x "${BINARY}" ] && [ ! -f "${BINARY}" ]; then
        log_msg "错误: 找不到二进制 ${BINARY}"
        return 1
    fi

    if [ -f "${DAEMON_SH}" ]; then
        chmod +x "${DAEMON_SH}" "${BINARY}" 2>/dev/null || true
        # 守护进程监督 bin/centag，并消费 storage/update_stop
        # run-as root 包模式下以包用户身份运行应用进程
        local pid
        pid="$(launch_as_service_user bash "${DAEMON_SH}" "${APP_ROOT}" | tail -1)"
        printf "%s" "${pid}" > "${PID_FILE}"
        sleep 2
        if ! kill -0 "${pid}" 2>/dev/null; then
            log_msg "daemon 启动失败，详见 ${LOGS_DIR}/daemon.log"
            rm -f "${PID_FILE}"
            return 1
        fi
        log_msg "Centag daemon 已启动，PID=${pid}"
        return 0
    fi

    # 回退：无 daemon.sh 时直启（旧包兼容）
    log_msg "未找到 daemon.sh，回退直启二进制"
    local pid
    pid="$(launch_as_service_user "${BINARY}" | tail -1)"
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "Centag 已启动（直启），PID=${pid}"
    return 0
}

# Thorough stop: PID files + process patterns + listeners on app ports.
# Used by fnOS stop and to avoid leftover daemon blocking reinstall.
# 记录无法终止的进程（其他用户启动时 kill 返回 EPERM，包用户无权处理）
log_unstoppable() {
    local pid="$1" owner cmd
    owner="$(awk '/^Uid:/{print $2}' "/proc/${pid}/status" 2>/dev/null)"
    cmd="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null | cut -c1-160)"
    log_msg "警告: pid=${pid} 属主 uid=${owner:-未知}，当前用户无权终止: ${cmd:-(cmdline 不可读)}"
}

stop_all_centag() {
    local pids="" pid p f
    local ports="${PORT} 8080 8081 8443"

    for f in \
        "${PID_FILE}" \
        "${APP_ROOT}/storage/centag.daemon.pid" \
        "${APP_ROOT}/storage/centag.pid"
    do
        if [ -r "$f" ]; then
            pid=$(tr -d '[:space:]' <"$f" 2>/dev/null || true)
            [ -n "$pid" ] && pids="${pids} ${pid}"
        fi
    done

    if command -v pgrep >/dev/null 2>&1; then
        pids="${pids} $(pgrep -f "daemon\\.sh ${APP_ROOT}" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f "${APP_ROOT}/daemon\\.sh" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f "${APP_ROOT}/bin/centag" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f '[.]/bin/centag' 2>/dev/null || true)"
    fi

    for p in ${ports}; do
        if command -v lsof >/dev/null 2>&1; then
            pids="${pids} $(lsof -tiTCP:"${p}" -sTCP:LISTEN 2>/dev/null || true)"
        fi
        if command -v fuser >/dev/null 2>&1; then
            pids="${pids} $(fuser "${p}/tcp" 2>/dev/null || true)"
        fi
    done

    # shellcheck disable=SC2086
    for pid in $(printf '%s\n' ${pids} | awk 'NF && !seen[$0]++'); do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "停止进程 PID=${pid}"
            kill -TERM "$pid" 2>/dev/null || true
        elif [ -d "/proc/${pid}" ]; then
            log_unstoppable "$pid"
        fi
    done
    sleep 2
    # shellcheck disable=SC2086
    for pid in $(printf '%s\n' ${pids} | awk 'NF && !seen[$0]++'); do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "强制停止 PID=${pid}"
            kill -KILL "$pid" 2>/dev/null || true
        elif [ -d "/proc/${pid}" ]; then
            log_unstoppable "$pid"
        fi
    done

    for p in ${ports}; do
        if command -v fuser >/dev/null 2>&1; then
            fuser -k "${p}/tcp" 2>/dev/null || true
        fi
    done

    rm -f "${PID_FILE}" \
        "${APP_ROOT}/storage/centag.daemon.pid" \
        "${APP_ROOT}/storage/centag.pid" \
        "${APP_ROOT}/storage/update_stop" \
        "${APP_ROOT}/storage/update_marker" \
        2>/dev/null || true
}

stop_process() {
    log_msg "正在停止 Centag（含 daemon / 端口清理）..."
    stop_all_centag
    log_msg "停止完成"
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            log_msg "进程已退出，清理残留 PID 文件"
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "用法: $0 {start|stop|status}"
    exit 1
    ;;
esac
