#!/bin/bash
# =============================================================
# Centag fnOS Native 应用 - 启动/停止/状态（daemon 监督）
# =============================================================

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

APP_ROOT="${TRIM_APPDEST}"
BINARY="${APP_ROOT}/bin/centag"
DAEMON_SH="${APP_ROOT}/daemon.sh"
STATIC_DIR="${APP_ROOT}/static"
# 兼容旧包 webui 布局
if [ ! -d "${STATIC_DIR}" ] && [ -d "${APP_ROOT}/webui" ]; then
    STATIC_DIR="${APP_ROOT}/webui"
fi
INITDATA_DIR="${APP_ROOT}/config/initdata"
RUNTIME_ENV="${APP_ROOT}/config/runtime.env"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
LOGS_DIR="${TRIM_PKGVAR}/logs"
PORT=20060

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

load_runtime_env() {
    if [ -f "${RUNTIME_ENV}" ]; then
        set -a
        # shellcheck disable=SC1090
        . "${RUNTIME_ENV}"
        set +a
        log_msg "已加载运行时配置: ${RUNTIME_ENV}"
    else
        log_msg "未找到 runtime.env，使用内置默认值"
    fi
}

# 读取配置页持久化的 centag.conf，覆盖数据库等运行配置
# 优先级: 环境变量(runtime.env) > centag.conf > 内置默认
load_app_config() {
    local conf="${DATA_DIR}/centag.conf"
    [ -f "${conf}" ] || return 0

    local val
    json_get() {
        grep -oE "\"${1}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "${conf}" 2>/dev/null | head -1 \
            | sed -E 's/^"[^"]*"[[:space:]]*:[[:space:]]*"([^"]*)"/\1/' \
            | tr -d ' \t\r'
    }

    val="$(json_get db_driver)"
    if [ -n "${val}" ]; then
        export LLM_PROXY_DB_DRIVER="${LLM_PROXY_DB_DRIVER:-${val}}"
    fi
    val="$(json_get pg_host)";  [ -n "${val}" ] && export POSTGRES_HOST="${POSTGRES_HOST:-${val}}"
    val="$(json_get pg_port)";  [ -n "${val}" ] && export POSTGRES_PORT="${POSTGRES_PORT:-${val}}"
    val="$(json_get pg_user)";  [ -n "${val}" ] && export POSTGRES_USER="${POSTGRES_USER:-${val}}"
    val="$(json_get pg_password)"; [ -n "${val}" ] && export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-${val}}"
    val="$(json_get pg_db)";    [ -n "${val}" ] && export POSTGRES_DB="${POSTGRES_DB:-${val}}"

    log_msg "已加载应用配置: ${conf} (db=${LLM_PROXY_DB_DRIVER:-sqlite})"
}

prepare_env() {
    mkdir -p "${DATA_DIR}"
    mkdir -p "${LOGS_DIR}"
    mkdir -p "${APP_ROOT}/storage"

    load_runtime_env
    load_app_config

    if [ "${LLM_PROXY_DB_DRIVER}" = "postgresql" ]; then
        export POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
        export POSTGRES_PORT="${POSTGRES_PORT:-5432}"
        export POSTGRES_USER="${POSTGRES_USER:-postgres}"
        export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-}"
        export POSTGRES_DB="${POSTGRES_DB:-centag}"
        export LLM_PROXY_DB_PATH="${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
        log_msg "数据库: PostgreSQL ${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
    else
        export SQLITE_PATH="${SQLITE_PATH:-${DATA_DIR}/centag.db}"
        export LLM_PROXY_DB_PATH="${LLM_PROXY_DB_PATH:-${SQLITE_PATH}}"
        log_msg "数据库: SQLite ${SQLITE_PATH}"
    fi
    export SERVER_HOST="${SERVER_HOST:-0.0.0.0}"
    export SERVER_PORT="${SERVER_PORT:-${PORT}}"
    export LLM_PROXY_SERVER_HOST="${LLM_PROXY_SERVER_HOST:-${SERVER_HOST}}"
    export LLM_PROXY_SERVER_PORT="${LLM_PROXY_SERVER_PORT:-${SERVER_PORT}}"
    export LOG_LEVEL="${LOG_LEVEL:-info}"
    export LLM_PROXY_LOG_OUTPUT="${LLM_PROXY_LOG_OUTPUT:-both}"
    export LLM_PROXY_LOG_PATH="${LLM_PROXY_LOG_PATH:-${LOGS_DIR}}"
    export TZ="${TZ:-Asia/Shanghai}"
    export LANG="${LANG:-C.UTF-8}"

    export STATIC_PATH="${STATIC_DIR}"
    export PROJECT_ROOT="${APP_ROOT}"
    export INITDATA_PATH="${INITDATA_PATH:-${INITDATA_DIR}}"
    export CENTAG_DATA_DIR="${CENTAG_DATA_DIR:-${DATA_DIR}}"
}

start_process() {
    if status; then
        log_msg "应用已在运行中，跳过启动"
        return 0
    fi

    log_msg "正在启动 Centag（daemon）..."
    prepare_env

    if [ ! -x "${BINARY}" ] && [ ! -f "${BINARY}" ]; then
        log_msg "错误: 找不到二进制 ${BINARY}"
        return 1
    fi

    if [ -f "${DAEMON_SH}" ]; then
        chmod +x "${DAEMON_SH}" "${BINARY}" 2>/dev/null || true
        # 守护进程监督 bin/centag，并消费 storage/update_stop
        nohup bash "${DAEMON_SH}" "${APP_ROOT}" >> "${LOGS_DIR}/daemon.log" 2>&1 &
        local pid=$!
        printf "%s" "${pid}" > "${PID_FILE}"
        sleep 2
        if ! kill -0 "${pid}" 2>/dev/null; then
            log_msg "daemon 启动失败，详见 ${LOGS_DIR}/daemon.log"
            rm -f "${PID_FILE}"
            return 1
        fi
        log_msg "Centag daemon 已启动，PID=${pid}"
        return 0
    fi

    # 回退：无 daemon.sh 时直启（旧包兼容）
    log_msg "未找到 daemon.sh，回退直启二进制"
    nohup "${BINARY}" >> "${LOGS_DIR}/centag.log" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "Centag 已启动（直启），PID=${pid}"
    return 0
}

# Thorough stop: PID files + process patterns + listeners on app ports.
# Used by fnOS stop and to avoid leftover daemon blocking reinstall.
stop_all_centag() {
    local pids="" pid p f
    local ports="${PORT} 8080 8081 8443"

    for f in \
        "${PID_FILE}" \
        "${APP_ROOT}/storage/centag.daemon.pid" \
        "${APP_ROOT}/storage/centag.pid"
    do
        if [ -r "$f" ]; then
            pid=$(tr -d '[:space:]' <"$f" 2>/dev/null || true)
            [ -n "$pid" ] && pids="${pids} ${pid}"
        fi
    done

    if command -v pgrep >/dev/null 2>&1; then
        pids="${pids} $(pgrep -f "daemon\\.sh ${APP_ROOT}" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f "${APP_ROOT}/daemon\\.sh" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f "${APP_ROOT}/bin/centag" 2>/dev/null || true)"
        pids="${pids} $(pgrep -f '[.]/bin/centag' 2>/dev/null || true)"
    fi

    for p in ${ports}; do
        if command -v lsof >/dev/null 2>&1; then
            pids="${pids} $(lsof -tiTCP:"${p}" -sTCP:LISTEN 2>/dev/null || true)"
        fi
        if command -v fuser >/dev/null 2>&1; then
            pids="${pids} $(fuser "${p}/tcp" 2>/dev/null || true)"
        fi
    done

    # shellcheck disable=SC2086
    for pid in $(printf '%s\n' ${pids} | awk 'NF && !seen[$0]++'); do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "停止进程 PID=${pid}"
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done
    sleep 2
    # shellcheck disable=SC2086
    for pid in $(printf '%s\n' ${pids} | awk 'NF && !seen[$0]++'); do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "强制停止 PID=${pid}"
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done

    for p in ${ports}; do
        if command -v fuser >/dev/null 2>&1; then
            fuser -k "${p}/tcp" 2>/dev/null || true
        fi
    done

    rm -f "${PID_FILE}" \
        "${APP_ROOT}/storage/centag.daemon.pid" \
        "${APP_ROOT}/storage/centag.pid" \
        "${APP_ROOT}/storage/update_stop" \
        "${APP_ROOT}/storage/update_marker" \
        2>/dev/null || true
}

stop_process() {
    log_msg "正在停止 Centag（含 daemon / 端口清理）..."
    stop_all_centag
    log_msg "停止完成"
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            log_msg "进程已退出，清理残留 PID 文件"
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "用法: $0 {start|stop|status}"
    exit 1
    ;;
esac
