#!/bin/bash

### This script is called after the user installs the application.
### 安装向导（wizard/install）选择的数据库写入 ${DATA_DIR}/centag.conf，
### 供 cmd/main 启动时读取（注入 LLM_PROXY_DB_DRIVER / POSTGRES_*）。
### 若已存在配置文件（卸载保留后重装），则保留原配置不覆盖。

# 多重回退查找数据目录（与 uninstall_init / uninstall_callback 保持一致）
resolve_data_dir() {
  local dd="${TRIM_DATA_SHARE_PATHS%%:*}"
  [ -n "$dd" ] && [ -d "$dd" ] && { printf '%s' "$dd"; return; }
  local candidate
  for candidate in \
    "/vol1/@appshare/centag" \
    "/vol1/@appshare/centag/data" \
    "${TRIM_APPDEST:-/vol1/@appcenter/centag}/data" \
    "/vol1/@appdata/centag/data"
  do
    [ -d "$candidate" ] && { printf '%s' "$candidate"; return; }
  done
  printf '%s' "${TRIM_DATA_SHARE_PATHS%%:*}"
}

DATA_DIR="$(resolve_data_dir)"
CONF_FILE="${DATA_DIR}/centag.conf"
# 程序目录（生命周期脚本所在）：卸载时数据卷可能已被移除，这里持久化 PG 连接信息，
# 供 uninstall_init / uninstall_callback 在数据卷消失后仍能 DROP DATABASE。
PGCLEAN_FILE="$(cd "$(dirname "$0")" && pwd)/.pgclean"

mkdir -p "${DATA_DIR}"
mkdir -p "${TRIM_PKGVAR}/logs"

# 检测已有数据（支持卸载保留后重装恢复）
if [ -f "${DATA_DIR}/centag.db" ]; then
  echo "检测到已有数据库，将使用保留的数据: ${DATA_DIR}/centag.db"
fi

# json_escape 转义 JSON 字符串中的特殊字符
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

# 从已有 centag.conf 提取 PG 连接信息写入 .pgclean（用于未来卸载清理）
persist_pgclean_from_conf() {
  [ -f "${CONF_FILE}" ] || return 0
  local drv
  drv="$(grep -oE '"db_driver"[[:space:]]*:[[:space:]]*"[a-z]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([a-z]*)"/\1/')"
  [ "${drv}" = "postgresql" ] || { rm -f "${PGCLEAN_FILE}" 2>/dev/null; return 0; }
  local h p u w d
  h="$(grep -oE '"pg_host"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  p="$(grep -oE '"pg_port"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  u="$(grep -oE '"pg_user"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  w="$(grep -oE '"pg_password"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  d="$(grep -oE '"pg_db"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  {
    printf '{"db_driver":"postgresql",'
    printf '"pg_host":"%s",'   "$(json_escape "${h:-localhost}")"
    printf '"pg_port":"%s",'   "$(json_escape "${p:-5432}")"
    printf '"pg_user":"%s",'   "$(json_escape "${u:-postgres}")"
    printf '"pg_password":"%s",' "$(json_escape "${w:-}")"
    printf '"pg_db":"%s"}'     "$(json_escape "${d:-centag}")"
  } > "${PGCLEAN_FILE}"
  chmod 600 "${PGCLEAN_FILE}" 2>/dev/null || true
  echo "已持久化 PG 连接信息到 ${PGCLEAN_FILE}（供卸载时 DROP DATABASE）"
}

# 若已存在配置（保留自上次安装），跳过默认写入，但确保 .pgclean 与当前配置一致
if [ -f "${CONF_FILE}" ]; then
  echo "检测到已有配置文件，保留: ${CONF_FILE}"
  persist_pgclean_from_conf
else
  # 根据安装向导写入数据库配置
  db_driver="${wizard_db_driver:-sqlite}"

  if [ "${db_driver}" = "postgresql" ]; then
    {
      printf '{"clean_data_on_uninstall":false,'
      printf '"db_driver":"postgresql",'
      printf '"pg_host":"%s",'   "$(json_escape "${wizard_pg_host:-localhost}")"
      printf '"pg_port":"%s",'   "$(json_escape "${wizard_pg_port:-5432}")"
      printf '"pg_user":"%s",'   "$(json_escape "${wizard_pg_user:-postgres}")"
      printf '"pg_password":"%s",' "$(json_escape "${wizard_pg_password:-}")"
      printf '"pg_db":"%s"}'     "$(json_escape "${wizard_pg_db:-centag}")"
    } > "${CONF_FILE}"
    echo "已按安装向导启用 PostgreSQL 并写入配置: ${CONF_FILE}"
    # 同步持久化 PG 连接信息
    {
      printf '{"db_driver":"postgresql",'
      printf '"pg_host":"%s",'   "$(json_escape "${wizard_pg_host:-localhost}")"
      printf '"pg_port":"%s",'   "$(json_escape "${wizard_pg_port:-5432}")"
      printf '"pg_user":"%s",'   "$(json_escape "${wizard_pg_user:-postgres}")"
      printf '"pg_password":"%s",' "$(json_escape "${wizard_pg_password:-}")"
      printf '"pg_db":"%s"}'     "$(json_escape "${wizard_pg_db:-centag}")"
    } > "${PGCLEAN_FILE}"
    chmod 600 "${PGCLEAN_FILE}" 2>/dev/null || true
    echo "已持久化 PG 连接信息到 ${PGCLEAN_FILE}（供卸载时 DROP DATABASE）"
  else
    printf '{"clean_data_on_uninstall":false,"db_driver":"sqlite"}' > "${CONF_FILE}"
    rm -f "${PGCLEAN_FILE}" 2>/dev/null || true
    echo "已按安装向导启用 SQLite 并写入配置: ${CONF_FILE}"
  fi
fi

# ── PostgreSQL 就绪保障（无论首装还是保留数据重装都执行）─────────────────────
# 产品契约：用户在安装向导填入正确的 PG 连接信息，应用即可连接、初始化并使用。
# fnOS 系统 PG 的限制：
#   - pg_hba 通常只放行业务库 TCP（admin 库 postgres/template1 被拒）
#   - `local all postgres peer map=trim_root` 抢在 `local all all md5` 之前，
#     包用户密码 socket 登录 postgres 角色必然失败
# 因此特权包模式（run-as root）下以 root peer（trim_root map）直接管理：
#   1) CREATE DATABASE（socket peer，免密）
#   2) pg_hba 放行目标库 loopback TCP 并 reload（应用以 TCP 连接）
#   3) 角色密码校验：TCP 登录失败且向导给了密码时，经 socket 设置角色密码
# 非 root 环境则退回 socket 密码/TCP 尝试；全部失败仅告警（应用降级数据卷
# SQLite，数据仍受「保留数据」保护），不阻断安装。
pg_ready() {
  local conf="$1"
  [ -f "${conf}" ] || return 0
  grep -q '"db_driver"[[:space:]]*:[[:space:]]*"postgresql"' "${conf}" || return 0

  command -v psql >/dev/null 2>&1 || { echo "[WARN] 未找到 psql，跳过 PostgreSQL 就绪检查"; return 0; }

  local h p u w d
  h="$(grep -oE '"pg_host"[[:space:]]*:[[:space:]]*"[^"]*"' "${conf}" | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  p="$(grep -oE '"pg_port"[[:space:]]*:[[:space:]]*"[^"]*"' "${conf}" | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  u="$(grep -oE '"pg_user"[[:space:]]*:[[:space:]]*"[^"]*"' "${conf}" | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  w="$(grep -oE '"pg_password"[[:space:]]*:[[:space:]]*"[^"]*"' "${conf}" | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  d="$(grep -oE '"pg_db"[[:space:]]*:[[:space:]]*"[^"]*"' "${conf}" | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  h="${h:-localhost}"; p="${p:-5432}"; u="${u:-postgres}"; d="${d:-centag}"

  # root 时的免密管理连接：本机 unix socket → peer(map=trim_root)
  local PSQL_ADMIN=""
  if [ "$(id -u)" = "0" ]; then
    for PSOCK in /var/run/postgresql /run/postgresql /tmp; do
      [ -S "${PSOCK}/.s.PGSQL.${p}" ] || continue
      PSQL_ADMIN="psql -h ${PSOCK} -p ${p} -U ${u}"
      break
    done
  fi

  # 1) 目标库已存在？root 时优先本机 socket peer（免密）；否则 TCP+向导密码
  local exists=""
  if [ -n "${PSQL_ADMIN}" ] && [ "$(${PSQL_ADMIN} -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname='${d}'" 2>/dev/null)" = "1" ]; then
    exists="1"
  else
    exists="$(PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname='${d}'" 2>/dev/null)"
  fi

  # 2) 不存在则建库（root socket peer 优先；失败再试 TCP admin）
  if [ "${exists}" != "1" ]; then
    echo "PostgreSQL 数据库 ${d} 不存在，尝试创建…"
    local created=""
    if [ "$(id -u)" = "0" ]; then
      for sock in /var/run/postgresql /run/postgresql /tmp; do
        [ -S "${sock}/.s.PGSQL.${p}" ] || continue
        psql -h "${sock}" -p "${p}" -U "${u}" -d postgres -c "CREATE DATABASE \"${d}\"" >/dev/null 2>&1 && { created="1"; break; }
      done
    fi
    if [ -z "${created}" ]; then
      PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d postgres \
        -c "CREATE DATABASE \"${d}\"" >/dev/null 2>&1 && created="1"
    fi
    if [ -n "${created}" ]; then
      echo "已创建 PostgreSQL 数据库: ${d}"
    else
      echo "[WARN] 无法创建 PostgreSQL 数据库 ${d}（admin 连接被 pg_hba 拒绝、权限不足或服务不可达）"
      echo "       应用启动将降级使用数据卷 SQLite（${DATA_DIR}/centag.db，卸载保留数据受保护）"
      echo "       如坚持使用 PostgreSQL，请在服务器以管理员执行（示例）："
      echo "         psql -U postgres -c \"CREATE DATABASE ${d};\""
      return 0
    fi
  fi

  # 3) 本机 PG 时，确保 pg_hba 放行「目标库、角色、TCP」（应用以 TCP 连接）
  if [ "$(id -u)" = "0" ] && { [ "${h}" = "localhost" ] || [ "${h}" = "127.0.0.1" ]; }; then
    local hba reloaded=0
    for hba in /etc/postgresql/*/main/pg_hba.conf; do
      [ -f "${hba}" ] || continue
      if ! grep -qE "^host[[:space:]]+${d}\b" "${hba}"; then
        {
          echo "# --- managed by centag (auto-added) ---"
          echo "host ${d} ${u} 127.0.0.1/32 scram-sha-256"
          echo "host ${d} ${u} ::1/128         scram-sha-256"
          echo "host ${d} ${u} 0.0.0.0/0       scram-sha-256"
        } >> "${hba}"
        echo "已向 ${hba} 追加 ${d} 的 TCP 放行规则"
      fi
    done
    systemctl reload postgresql >/dev/null 2>&1 && reloaded=1 ||
      pg_ctlcluster "$(ls /etc/postgresql 2>/dev/null | head -1)" main reload >/dev/null 2>&1 && reloaded=1 || true
    [ "${reloaded}" = "1" ] && echo "已重载 PostgreSQL 配置" || echo "[WARN] 无法重载 PostgreSQL 配置（新建规则需手动 reload 生效）"
  fi

  # 4) 角色密码校验：应用以 TCP+密码连接；失败且向导给了密码 → 经 socket 设置密码
  if PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d "${d}" -Atqc "SELECT 1" >/dev/null 2>&1; then
    echo "PostgreSQL 连接验证通过: 127.0.0.1:${p}/${d}"
  else
    if [ -n "${w}" ] && [ "$(id -u)" = "0" ] && [ -e /var/run/postgresql/.s.PGSQL.${p} ]; then
      echo "TCP 密码登录失败，尝试为角色 ${u} 设置密码（fnOS 系统 PG 的 postgres 角色默认无密码）…"
      psql -h /var/run/postgresql -p "${p}" -U "${u}" -d postgres \
        -c "ALTER ROLE \"${u}\" WITH PASSWORD '${w}'" >/dev/null 2>&1 \
        && echo "已设置角色 ${u} 的访问密码" || echo "[WARN] 无法设置角色密码（请手动执行 ALTER ROLE）"
    fi
    if PGPASSWORD="${w}" psql -h 127.0.0.1 -p "${p}" -U "${u}" -d "${d}" -Atqc "SELECT 1" >/dev/null 2>&1; then
      echo "PostgreSQL 连接验证通过: 127.0.0.1:${p}/${d}"
    else
      echo "[WARN] PostgreSQL TCP 连接验证失败: 127.0.0.1:${p}/${d}（应用将降级数据卷 SQLite）"
    fi
  fi
  return 0
}
pg_ready "${CONF_FILE}"

exit 0