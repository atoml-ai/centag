#!/bin/bash

### This script is called after the user installs the application.
### 安装向导（wizard/install）选择的数据库写入 ${DATA_DIR}/centag.conf，
### 供 cmd/main 启动时读取（注入 LLM_PROXY_DB_DRIVER / POSTGRES_*）。
### 若已存在配置文件（卸载保留后重装），则保留原配置不覆盖。

DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
CONF_FILE="${DATA_DIR}/centag.conf"
# 程序目录（生命周期脚本所在）：卸载时数据卷可能已被移除，这里持久化 PG 连接信息，
# 供 uninstall_init / uninstall_callback 在数据卷消失后仍能 DROP DATABASE。
PGCLEAN_FILE="$(cd "$(dirname "$0")" && pwd)/.pgclean"

mkdir -p "${DATA_DIR}"
mkdir -p "${TRIM_PKGVAR}/logs"

# 检测已有数据（支持卸载保留后重装恢复）
if [ -f "${DATA_DIR}/centag.db" ]; then
  echo "检测到已有数据库，将使用保留的数据: ${DATA_DIR}/centag.db"
fi

# json_escape 转义 JSON 字符串中的特殊字符
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

# 从已有 centag.conf 提取 PG 连接信息写入 .pgclean（用于未来卸载清理）
persist_pgclean_from_conf() {
  [ -f "${CONF_FILE}" ] || return 0
  local drv
  drv="$(grep -oE '"db_driver"[[:space:]]*:[[:space:]]*"[a-z]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([a-z]*)"/\1/')"
  [ "${drv}" = "postgresql" ] || { rm -f "${PGCLEAN_FILE}" 2>/dev/null; return 0; }
  local h p u w d
  h="$(grep -oE '"pg_host"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  p="$(grep -oE '"pg_port"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  u="$(grep -oE '"pg_user"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  w="$(grep -oE '"pg_password"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  d="$(grep -oE '"pg_db"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONF_FILE}" 2>/dev/null | head -1 | sed -E 's/.*:"([^"]*)"/\1/')"
  {
    printf '{"db_driver":"postgresql",'
    printf '"pg_host":"%s",'   "$(json_escape "${h:-localhost}")"
    printf '"pg_port":"%s",'   "$(json_escape "${p:-5432}")"
    printf '"pg_user":"%s",'   "$(json_escape "${u:-postgres}")"
    printf '"pg_password":"%s",' "$(json_escape "${w:-}")"
    printf '"pg_db":"%s"}'     "$(json_escape "${d:-centag}")"
  } > "${PGCLEAN_FILE}"
  chmod 600 "${PGCLEAN_FILE}" 2>/dev/null || true
  echo "已持久化 PG 连接信息到 ${PGCLEAN_FILE}（供卸载时 DROP DATABASE）"
}

# 若已存在配置（保留自上次安装），跳过默认写入，但确保 .pgclean 与当前配置一致
if [ -f "${CONF_FILE}" ]; then
  echo "检测到已有配置文件，保留: ${CONF_FILE}"
  persist_pgclean_from_conf
  exit 0
fi

# 根据安装向导写入数据库配置
db_driver="${wizard_db_driver:-sqlite}"

if [ "${db_driver}" = "postgresql" ]; then
  {
    printf '{"clean_data_on_uninstall":false,'
    printf '"db_driver":"postgresql",'
    printf '"pg_host":"%s",'   "$(json_escape "${wizard_pg_host:-localhost}")"
    printf '"pg_port":"%s",'   "$(json_escape "${wizard_pg_port:-5432}")"
    printf '"pg_user":"%s",'   "$(json_escape "${wizard_pg_user:-postgres}")"
    printf '"pg_password":"%s",' "$(json_escape "${wizard_pg_password:-}")"
    printf '"pg_db":"%s"}'     "$(json_escape "${wizard_pg_db:-centag}")"
  } > "${CONF_FILE}"
  echo "已按安装向导启用 PostgreSQL 并写入配置: ${CONF_FILE}"
  # 同步持久化 PG 连接信息
  {
    printf '{"db_driver":"postgresql",'
    printf '"pg_host":"%s",'   "$(json_escape "${wizard_pg_host:-localhost}")"
    printf '"pg_port":"%s",'   "$(json_escape "${wizard_pg_port:-5432}")"
    printf '"pg_user":"%s",'   "$(json_escape "${wizard_pg_user:-postgres}")"
    printf '"pg_password":"%s",' "$(json_escape "${wizard_pg_password:-}")"
    printf '"pg_db":"%s"}'     "$(json_escape "${wizard_pg_db:-centag}")"
  } > "${PGCLEAN_FILE}"
  chmod 600 "${PGCLEAN_FILE}" 2>/dev/null || true
  echo "已持久化 PG 连接信息到 ${PGCLEAN_FILE}（供卸载时 DROP DATABASE）"
else
  printf '{"clean_data_on_uninstall":false,"db_driver":"sqlite"}' > "${CONF_FILE}"
  rm -f "${PGCLEAN_FILE}" 2>/dev/null || true
  echo "已按安装向导启用 SQLite 并写入配置: ${CONF_FILE}"
fi

exit 0