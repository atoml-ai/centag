# Proxy Claw 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
#
# ============================================
# 数据库配置（PostgreSQL 或 SQLite）
# ============================================
# 数据库类型：auto（自动检测）| postgresql | sqlite
# - auto: 自动检测，有 PG_HOST 时使用 PostgreSQL，否则使用 SQLite
# - postgresql: 强制使用 PostgreSQL（需要配置 PG_* 环境变量）
# - sqlite: 强制使用 SQLite（无需 PG 配置，开箱即用）
LLM_PROXY_DB_DRIVER=auto

# --------------------------------------------
# PostgreSQL 配置（当使用 PostgreSQL 时填写）
# --------------------------------------------
# 宿主机调试：使用 localhost:5432
# 容器调试：使用 postgresql:5432（Docker Compose 自动设置）
# 生产环境：使用实际 PostgreSQL 服务器地址

PG_HOST=localhost
PG_PORT=5432
PG_USER=llmproxy
PG_PASSWORD=your_s...here
PG_DATABASE=proxyclaw
PG_SSL_MODE=disable  # disable, require, verify-full, require-no-verify

# PostgreSQL 连接池配置
PG_MAX_CONNECTIONS=20

# --------------------------------------------
# SQLite 配置（当使用 SQLite 时填写）
# --------------------------------------------
# SQLite 是文件型数据库，无需部署，开箱即用
# 适用于：开发测试、小型部署、无 PostgreSQL 环境
# 注意：SQLite 不支持向量召回功能（需要 PostgreSQL + pgvector）

SQLITE_PATH=./storage/proxyclaw.db

# ============================================
# 服务器配置
# ============================================

SERVER_HOST=0.0.0.0
SERVER_PORT=20060

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE_PATH=./logs
LOG_FILE_NAME=proxyclaw.log
LOG_MAX_SIZE=100  # MB
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30    # days

# ============================================
# JWT 配置
# ============================================

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h  # 7 days

# ============================================
# Redis 配置（可选）
# ============================================

REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 缓存配置
# ============================================

CACHE_ENABLED=true
CACHE_TYPE=memory  # memory, redis
CACHE_TTL=3600     # seconds

# ============================================
# 向量数据库配置（可选）
# ============================================

VECTOR_ENABLED=false
VECTOR_TYPE=chromadb  # chromadb, pgvector, elasticsearch
VECTOR_ADDR=localhost:8000

# ============================================
# Ollama 配置（可选）
# ============================================

OLLAMA_ENABLED=false
OLLAMA_ADDR=http://localhost:21434
OLLAMA_DEFAULT_MODEL=bge-m3

# ============================================
# 问题拆分配置
# ============================================

QUESTION_SPLIT_ENABLED=false
QUESTION_SPLIT_LLM_ENABLED=false
QUESTION_SPLIT_BACKEND_ID=ollama-local

# ============================================
# 预设模式配置
# ============================================

PRESET_MODES_ENABLED=true

# ============================================
# 流水线模板模式开关
# ============================================
# 启用后，对应代理模式将使用流水线模板实现（插件化）
# 禁用则使用 legacy 硬编码实现
# 注意：流水线模板文件需存在于 configs/pipelines/ 目录

# #a 审核模式 - 执行 → 审核 → 返回
LLM_PROXY_MODE_A_TEMPLATE_ENABLED=false

# #o 优化模式 - 执行 → 优化 → 返回优化后的答案
LLM_PROXY_MODE_O_TEMPLATE_ENABLED=false

# #d 直接后端模式 - 单个 LLM 节点直接路由到指定后端
LLM_PROXY_MODE_D_TEMPLATE_ENABLED=false

# #t 透明代理模式 - 透传请求到目标地址
LLM_PROXY_MODE_T_TEMPLATE_ENABLED=false

# #f 降级模式 - 主后端失败后自动降级到备用后端
LLM_PROXY_MODE_F_TEMPLATE_ENABLED=false

# #m 模型匹配模式 - 使用小模型分析 + 路由决策
LLM_PROXY_MODE_M_TEMPLATE_ENABLED=false

# #c 意图分类模式 - 支持意图识别和路由
LLM_PROXY_MODE_C_TEMPLATE_ENABLED=false

# #p 流水线模式 - 使用可配置的流水线编排多阶段AI处理
LLM_PROXY_MODE_P_TEMPLATE_ENABLED=false

# ============================================
# 系统代理配置
# ============================================

SYSTEM_PROXY_ENABLED=false
SYSTEM_PROXY_HTTP=
SYSTEM_PROXY_HTTPS=

# ============================================
# Host 代理配置
# ============================================

HOST_PROXY_ENABLED=false

# ============================================
# 插件配置
# ============================================

PLUGINS_ENABLED=true
PLUGINS_DIR=./plugins

# ============================================
# 存储配置
# ============================================

DEFAULT_STORAGE=local
STORAGE_LOCAL_PATH=./storage

# ============================================
# 安全配置
# ============================================

# 首次启动时创建默认管理员用户
# 用户名：admin
# 密码：请设置一个强密码，不要使用默认密码
DEFAULT_ADMIN_PASSWORD=

# API 请求速率限制（可选）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds
